# Supabase 프로젝트 설정 → API 에서 복사한다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role(secret) 키. 서버에서만 쓰고 앱에는 절대 넣지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# 세션 토큰 서명 키. `openssl rand -base64 48` 로 만든다. (32자 이상)
JWT_SECRET=
# 토큰 유효 기간(일)
TOKEN_TTL_DAYS=30

PORT=3000
# 근무일·지각 판정의 기준 타임존
APP_TIMEZONE=Asia/Seoul
